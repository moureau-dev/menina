{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menina.moureau.dev/schema/v1/menina.schema.json",
  "title": "Menina repository manifest",
  "description": "Schema for .menina.yml, the repository manifest read by the Menina client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "environment"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "default": 1
    },
    "project": {
      "$ref": "#/$defs/projectName"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "vars": {
      "type": "object",
      "description": "Non-secret values for ${VAR} interpolation.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "storages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/storage"
      }
    },
    "apps": {
      "type": "object",
      "description": "Listening workloads (services).",
      "propertyNames": {
        "$ref": "#/$defs/workloadName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workload"
      }
    },
    "workers": {
      "type": "object",
      "description": "Non-listening workloads (queues, background jobs).",
      "propertyNames": {
        "$ref": "#/$defs/workloadName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workload"
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "projectName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "workloadName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "buildArgs": {
      "type": "object",
      "description": "Docker build arguments. Not secrets and not runtime env.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "description": "Default Docker build context, relative to the manifest."
        },
        "tag": {
          "type": "string",
          "description": "Default image tag for built images."
        },
        "registry": {
          "type": "string",
          "description": "Registry host used to derive built image repositories."
        },
        "buildArgs": {
          "$ref": "#/$defs/buildArgs"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "path"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "PVC size, for example 1Gi."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Default mount path inside the container."
        },
        "access": {
          "type": "string",
          "enum": [
            "single-writer",
            "multi-writer"
          ],
          "default": "single-writer"
        },
        "snapshotBeforeDeploy": {
          "type": "boolean",
          "description": "Request a CSI VolumeSnapshot before a release changes the workload."
        }
      }
    },
    "storageEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "$ref": "#/$defs/workloadName"
        },
        "size": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "snapshotBeforeDeploy": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "use"
          ]
        },
        {
          "required": [
            "size",
            "path"
          ]
        }
      ]
    },
    "storageRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/workloadName"
        },
        {
          "$ref": "#/$defs/storageEntry"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/workloadName"
              },
              {
                "$ref": "#/$defs/storageEntry"
              }
            ]
          }
        }
      ]
    },
    "replicas": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "targetCPU": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "type": "string"
        },
        "liveness": {
          "type": "string"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string",
          "description": "Go duration, for example 5m. Bounded by the host."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "path": {
          "type": "string",
          "description": "HTTP path checked through the app's public route."
        },
        "method": {
          "type": "string",
          "default": "GET"
        },
        "expectStatus": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "expectBody": {
          "type": "string"
        },
        "expectHeader": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string"
        },
        "smokeTest": {
          "$ref": "#/$defs/hook"
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "recover",
            "keep"
          ],
          "default": "recover"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preDeploy": {
          "$ref": "#/$defs/hook"
        },
        "migrate": {
          "$ref": "#/$defs/hook"
        },
        "postDeploy": {
          "$ref": "#/$defs/hook"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "previous",
            "none",
            "require-approval"
          ],
          "default": "none"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "deploy-error",
              "verification-failure",
              "timeout",
              "interrupted"
            ]
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dockerfile": {
          "type": "string",
          "description": "Dockerfile path, relative to the manifest (or context)."
        },
        "image": {
          "type": "string",
          "description": "External image, or a repository override when dockerfile is set."
        },
        "context": {
          "type": "string",
          "description": "Docker build context, relative to the manifest."
        },
        "from": {
          "$ref": "#/$defs/workloadName",
          "description": "Reuse an app's image/build/env/secrets. Storage is not inherited."
        },
        "type": {
          "type": "string",
          "enum": [
            "service",
            "worker"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Legacy shorthand for service.port."
        },
        "host": {
          "type": "string",
          "description": "Legacy shorthand for exposure.http.hosts."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Runtime environment variables.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "description": "Secret names. Values live on the host, never in the manifest.",
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "buildArgs": {
          "$ref": "#/$defs/buildArgs"
        },
        "storage": {
          "$ref": "#/$defs/storageRef"
        },
        "replicas": {
          "$ref": "#/$defs/replicas"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "dependsOn": {
          "type": "array",
          "description": "Apps in the same environment that must deploy first.",
          "items": {
            "$ref": "#/$defs/workloadName"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "exposure": {
          "$ref": "#/$defs/exposure"
        }
      }
    },
    "service": {
      "type": "object",
      "description": "The app's primary container/Service port.",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "portOrList": {
      "oneOf": [
        {
          "$ref": "#/$defs/portNumber"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portNumber"
          }
        }
      ]
    },
    "ports": {
      "description": "Raw L4 ports published on the node via hostPort.",
      "oneOf": [
        {
          "$ref": "#/$defs/portNumber"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portNumber"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tcp": {
              "$ref": "#/$defs/portOrList"
            },
            "udp": {
              "$ref": "#/$defs/portOrList"
            }
          }
        }
      ]
    },
    "routeTimeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "string"
        },
        "write": {
          "type": "string"
        },
        "idle": {
          "type": "string"
        }
      }
    },
    "httpExposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pathPrefix": {
          "type": "string"
        },
        "redirectHttp": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "compression": {
          "type": "boolean"
        },
        "h2c": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "$ref": "#/$defs/routeTimeouts"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "$ref": "#/$defs/httpExposure"
        },
        "ports": {
          "$ref": "#/$defs/ports"
        }
      },
      "anyOf": [
        {
          "required": [
            "http"
          ]
        },
        {
          "required": [
            "ports"
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository that owns the apps declared by this manifest."
        },
        "revision": {
          "type": "string",
          "description": "Optional informational revision."
        }
      }
    }
  }
}
