[Unit]
Description=Menina reverse proxy
Documentation=https://menina.moureau.dev
After=network-online.target menina-serve.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
ExecStart=@BINARY@ --config-dir @CONFIG_DIR@ proxy
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
# Do not create the shared runtime directory here: systemd removes a
# RuntimeDirectory when this unit stops, which would unlink the control
# socket/token owned by menina-serve. serve creates it.
StateDirectory=menina
StateDirectoryMode=0750
Environment=MENINA_CONFIG_DIR=@CONFIG_DIR@
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
PrivateTmp=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=@DATA_DIR@ /run/menina

[Install]
WantedBy=multi-user.target
